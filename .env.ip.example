# TryPost — production .env for IP + port access (no domain, no TLS).
#
# Copy to /opt/trypost/.env on the server and fill the secrets. This mirrors
# .env.production but is tuned for reaching the app at http://<server-ip>:<port>
# instead of a domain over HTTPS. Deploy with scripts/deploy-ip.sh.
#
# SECURITY: plain http means logins and tokens travel unencrypted. Use only on
# internal / VPN / staging hosts; put TLS in front for a public deployment.

APP_NAME=TryPost
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show

# Point APP_URL at the SAME ip:port you publish on (APP_PORT below). The app
# builds every OAuth callback and absolute URL from this.
APP_URL=http://203.0.113.10:8000

# Port published on the host (consumed by compose.ip.yaml). Must match APP_URL.
APP_PORT=8000
# Interface to bind. 0.0.0.0 = reachable by the host's public/LAN IP.
APP_BIND=0.0.0.0

# Plain http: the session cookie must NOT require a secure (https) connection,
# or logins silently fail.
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=database

# Data + queues
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=trypost
DB_USERNAME=trypost
DB_PASSWORD=                  # set me

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Broadcasting / Reverb (WebSockets).
# REVERB_HOST is where the Reverb SERVER binds inside the container — 0.0.0.0 is
# correct. The in-container Nginx proxies /app and /apps on port 80, so the
# BROWSER reaches Reverb on the same ip:port it loaded the app from.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=1001
REVERB_APP_KEY=trypost-reverb-key
REVERB_APP_SECRET=            # set me
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# Passport keys — generate once with: php artisan passport:keys --show
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# --- Client build (Vite) ---
# LEAVE VITE_REVERB_HOST EMPTY. The compiled client then resolves the WebSocket
# host from the page's own origin (resources/js/echo.ts), so ONE pre-built image
# works over ANY ip:port without a rebuild. Only pin it when you build the image
# per-host. VITE_REVERB_APP_KEY must match REVERB_APP_KEY above.
VITE_REVERB_APP_KEY=trypost-reverb-key
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http

# AI (images via BytePlus Seedream) — set for image generation.
AI_TEXT_PROVIDER=deepseek
AI_IMAGE_PROVIDER=seedream
# SEEDREAM_API_KEY=
# SEEDREAM_IMAGE_MODEL=seedream-4-5-251128
